RewriteEngine On

# Let existing files and directories through, including PHP endpoints.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Keep PHP files executable.
RewriteRule \.php$ - [L]

# SPA fallback for all other routes.
RewriteRule ^ index.html [L]